# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env and fill in the values

# Application
APP_NAME=Indoor Duration Tracking API
APP_VERSION=2.0.0
DEBUG=False

# Database
DATABASE_URL=postgresql://indoor_user:indoor_pass_2026@localhost:5432/indoor_tracking

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=face_embeddings

# Redis
REDIS_URL=redis://localhost:6379

# File Storage
UPLOAD_DIR=./uploads
SNAPSHOT_DIR=./logs/snapshots
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes

# Face Recognition Thresholds
FACE_MATCH_THRESHOLD=0.60
FACE_HIGH_CONFIDENCE=0.75

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=*

# Camera IDs (UUIDs from database)
# Set these after cameras are registered in the system
CAMERA_ID_1=
CAMERA_ID_2=
CAMERA_ID_3=
CAMERA_ID_4=

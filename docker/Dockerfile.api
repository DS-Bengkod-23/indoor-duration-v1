# Dockerfile for FastAPI Backend API
FROM python:3.11-slim

LABEL maintainer="Indoor Duration Tracking System"
LABEL description="FastAPI Backend API"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (in optimal order for caching)
COPY requirements/base.txt ./requirements/
COPY requirements/api.txt ./requirements/

# Install Python dependencies (base first for better caching)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements/base.txt && \
    pip install --no-cache-dir -r requirements/api.txt

# Copy application code
COPY app/ ./app/
COPY indoor/ ./indoor/
COPY config/ ./config/
COPY alembic/ ./alembic/
COPY alembic.ini ./

# Create directories
RUN mkdir -p /app/uploads /app/logs

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')"

# Run database migrations and start server
CMD alembic upgrade head && \
    uvicorn app.main:app --host 0.0.0.0 --port 8000
